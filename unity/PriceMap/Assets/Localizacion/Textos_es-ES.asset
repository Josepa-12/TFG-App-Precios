  - m_Id: 365829618130944
    m_Localized: "Centrar en mi posici\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 365829647491072
    m_Localized: "PriceMap usa tu ubicaci\xF3n solo mientras tienes la app abierta,
