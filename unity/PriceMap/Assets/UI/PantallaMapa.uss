/* Pantalla del mapa (EXPERIENCE.md · Mapa de inicio; mockups/key-mapa-inicio.html). */

.pm-raiz {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.zona-segura {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Arriba a la derecha (prototipo .ctrl-stack, styles.css:152-154): 16 dp desde arriba y 12 desde la derecha */
.pila-derecha {
    position: absolute;
    top: var(--espacio-4);
    right: var(--espacio-3);
    flex-direction: column;
    align-items: flex-end;
}

/* Sombra suave de los controles flotantes (SombraSuave la dibuja con este color; prototipo --shadow) */
.sombra-suave {
    --sombra: var(--color-sombra);
}

/* Columna de cristal: tema y ubicación (y, con TalkBack, otra con acercar y alejar). El borde glass-edge lo dibuja
   SombraSuave por dentro, sin ocupar sitio: la columna mide 48 × 96 dp con dos huecos de 48 × 48 */
.columna-controles {
    flex-direction: column;
    border-radius: var(--radio-columna);
    background-color: var(--color-glass);
    --borde-cristal: var(--color-glass-edge);
}

.zoom {
    margin-top: var(--espacio-3);
    display: none;
}

.zoom.visible {
    display: flex;
}

/* Botón redondo con fondo de cristal (DESIGN.md · Components · round-button) */
.boton-redondo {
    width: var(--boton-redondo);
    height: var(--boton-redondo);
    min-width: var(--zona-tactil-min);
    min-height: var(--zona-tactil-min);
    border-radius: var(--radio-boton-redondo);
    background-color: var(--color-glass);
    border-width: 1px;
    border-color: var(--color-control-edge);
    color: var(--color-text);
}

.boton-redondo:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

.boton-redondo:active {
    background-color: var(--color-surface-2);
}

/* Hueco de la columna: sin fondo ni borde propios, icono en el texto de acento */
.boton-redondo--columna {
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-accent-text);
}

.boton-redondo--arriba {
    border-top-left-radius: var(--radio-columna);
    border-top-right-radius: var(--radio-columna);
}

.boton-redondo--abajo {
    border-bottom-left-radius: var(--radio-columna);
    border-bottom-right-radius: var(--radio-columna);
}

/* Línea de 1 dp entre los dos huecos, dentro de los 48 dp del de abajo */
.boton-redondo--separado {
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

/* Foco: anillo por dentro del hueco (prototipo outline-offset: -3px), también sobre la línea */
.boton-redondo--columna:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

/* Filtro "Precios" (DESIGN.md · prices-pill; EXPERIENCE.md · Mapa de inicio): píldora arriba a la
   izquierda y su menú justo debajo */
.hueco-precios {
    position: absolute;
    top: var(--espacio-4);
    left: var(--espacio-3);
    flex-direction: column;
    align-items: flex-start;
}

/* Prototipo .pill.glass: cristal con borde glass-edge casi invisible y la sombra suave (SombraSuave) */
.pildora-precios {
    flex-direction: row;
    align-items: center;
    min-height: var(--zona-tactil-min);
    padding: var(--espacio-2) var(--espacio-4) var(--espacio-2) var(--espacio-3);
    border-radius: var(--radio-pill);
    background-color: var(--color-glass);
    border-width: 1px;
    border-color: var(--color-glass-edge);
    color: var(--color-text);
}

.pildora-precios:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

.pildora-precios:active {
    background-color: var(--color-surface-2);
}

.pildora-precios__texto {
    color: var(--color-text);
    margin: 0 var(--espacio-2);
    padding: 0;
    white-space: normal;
    flex-shrink: 1;
}

/* Con Ninguno: "Ver precios" atenuado */
.pildora-precios--ninguno .pildora-precios__texto {
    color: var(--color-muted);
}

.pildora-precios__flecha {
    width: 12px;
    height: 8px;
    flex-shrink: 0;
    color: var(--color-text);
}

/* Con una categoría de "Encuentra cerca" (historia 2.4, parte 2): icono del chip (buscador__chip-icono y su
   color), el nombre y una ✕ en lugar de la flecha; el padding izquierdo se ajusta al círculo del icono */
.pildora-precios--categoria {
    padding-left: var(--espacio-2);
}

.pildora-precios__icono {
    margin: 0;
}

.pildora-precios__quitar {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--color-text);
}

/* Punto de color de cada opción (PuntoPrecios lo dibuja con su color) */
.punto-precios {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
}

.punto-precios--ninguno { color: var(--color-muted); }
.punto-precios--todos { color: var(--color-accent); }
.punto-precios--servicio { color: var(--color-pin-servicio); }
.punto-precios--hosteleria { color: var(--color-pin-hosteleria); }
.punto-precios--ocio { color: var(--color-pin-ocio); }

/* Prototipo .cat-menu (styles.css:141-148): 220 dp, relleno 6, esquinas 18, surface, sin borde y con la sombra suave */
.menu-precios {
    margin-top: var(--espacio-2);
    width: var(--menu-precios-ancho);
    padding: var(--menu-precios-relleno);
    border-radius: var(--radio-lg);
    background-color: var(--color-surface);
    border-width: 0;
}

/* Prototipo .menu-title: mayúsculas (desde el código), 11 px, 800, espaciado 0,05 em, muted, relleno 8/12/4 */
.menu-precios__titulo {
    color: var(--color-muted);
    margin: 0;
    padding: var(--espacio-2) var(--espacio-3) var(--espacio-1) var(--espacio-3);
    white-space: normal;
}

/* Prototipo .cat-menu button: esquinas 12, 14 px; alto mínimo de 48 dp (zona táctil), no 44 */
.opcion-precios {
    flex-direction: row;
    align-items: center;
    min-height: var(--zona-tactil-min);
    padding: var(--espacio-1) var(--espacio-3);
    border-radius: var(--radio-opcion);
    border-width: 0;
    color: var(--color-text);
}

.opcion-precios:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

/* La elegida, solo con el fondo surface-2 (sin check) */
.opcion-precios--elegida {
    background-color: var(--color-surface-2);
}

.opcion-precios__texto {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 0 0 10px;
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

/* Velo del menú: transparente y a pantalla completa, debajo de la píldora y del menú */
.velo-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.velo-menu.abierto {
    display: flex;
}

/* Atribución obligatoria de OpenFreeMap y OpenStreetMap: pequeña, abajo a la derecha */
.atribucion {
    position: absolute;
    right: var(--espacio-2);
    bottom: var(--espacio-2);
    max-width: 90%;
    padding: 2px var(--espacio-2);
    border-radius: var(--radio-xs);
    background-color: var(--color-glass);
    color: var(--color-muted);
    white-space: normal;
    -unity-text-align: middle-right;
}

/* Marcadores de los lugares (prototipo: styles.css · .pin). Cada .marcador mide 0×0 y está justo en
   la coordenada (CapaMarcadores lo mueve con translate): la punta acaba ahí y el resto cuelga hacia arriba.
   Nada captura toques: el mapa se mueve igual al arrastrar sobre un marcador. */
.capa-marcadores {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.marcador {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    color: var(--color-pin-borde);
}

/* Columna cuerpo + punta, centrada en X y apoyada en la coordenada */
.marcador__pin {
    position: absolute;
    left: 0;
    bottom: 0;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
}

.marcador__cuerpo {
    width: var(--marcador);
    height: var(--marcador);
    border-radius: var(--radio-md);
    border-width: 2.5px;
    border-color: var(--color-pin-borde);
    background-color: var(--color-pin-servicio);
    align-items: center;
    justify-content: center;
}

.marcador--hosteleria .marcador__cuerpo {
    background-color: var(--color-pin-hosteleria);
}

.marcador--ocio .marcador__cuerpo {
    background-color: var(--color-pin-ocio);
}

.marcador__logo {
    width: var(--marcador-logo);
    height: var(--marcador-logo);
}

/* Punta blanca de 8 dp (triángulo dibujado con Painter2D en todo su rectángulo) */
.marcador__punta {
    width: 12px;
    height: 8px;
    color: var(--color-pin-borde);
}

.marcador__insignia {
    position: absolute;
    top: -7px;
    right: -7px;
    width: var(--marcador-insignia);
    height: var(--marcador-insignia);
    border-radius: var(--radio-insignia);
    border-width: 2px;
    border-color: var(--color-pin-borde);
    background-color: var(--color-reward);
    color: var(--color-reward-ink);
}

/* Sin precio: secundario (más pequeño y atenuado, sin €) */
.marcador--sin-precio {
    opacity: 0.7;
}

.marcador--sin-precio .marcador__cuerpo {
    width: var(--marcador-sin-precio);
    height: var(--marcador-sin-precio);
    border-radius: var(--radio-sm);
    border-width: 2px;
}

.marcador--sin-precio .marcador__logo {
    width: var(--marcador-logo-sin-precio);
    height: var(--marcador-logo-sin-precio);
}

.marcador--sin-precio .marcador__punta {
    width: 10px;
    height: 6px;
}

/* Posición del usuario (prototipo: styles.css · .me). .marcador-posicion mide 0×0 y está justo en la
   coordenada (MarcadorPosicion lo mueve con translate); el cono y el círculo van centrados en ella.
   Nada captura toques. */
.capa-posicion {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.marcador-posicion {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* Cono translúcido (sector dibujado con Painter2D hacia arriba; lo gira style.rotate alrededor de su centro) */
.marcador-posicion__cono {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--posicion-cono);
    height: var(--posicion-cono);
    translate: -50% -50%;
    color: var(--color-posicion-cono);
}

.marcador-posicion__punto {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--posicion-punto);
    height: var(--posicion-punto);
    translate: -50% -50%;
    border-radius: var(--radio-posicion-punto);
    border-width: 3px;
    border-color: var(--color-posicion-borde);
    background-color: var(--color-posicion);
}

/* Chincheta del punto libre (historia 2.5). .chincheta mide 0×0 y está justo en la coordenada (ChinchetaPunto la
   mueve con translate); la gota (dibujada con Painter2D) tiene la punta en ella y la sombra va centrada debajo.
   Su color es el del borde y el centro; el de la gota, el del cuerpo. --chincheta-borde: grosor del borde en
   unidades de la maqueta (34 × 44). Nada captura toques. */
.capa-chincheta {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.chincheta {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    color: var(--color-chincheta-detalle);
    --chincheta-borde: 3;
}

.pm-raiz.tema-oscuro .chincheta {
    --chincheta-borde: 2;
}

.chincheta__gota {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--chincheta-ancho);
    height: var(--chincheta-alto);
    translate: -50% -97%; /* la punta (y = 42,8 de 44) cae en la coordenada */
    color: var(--color-chincheta);
}

.chincheta__sombra {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 5px;
    translate: -50% -50%;
    border-radius: 2.5px;
    background-color: var(--color-chincheta-sombra);
}

/* Explicación del permiso de ubicación: velo a pantalla completa y tarjeta centrada */
.hueco-explicacion {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.explicacion-ubicacion {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--espacio-5);
    background-color: var(--color-velo-modal);
}

.explicacion-ubicacion__tarjeta {
    width: 100%;
    max-width: var(--modal-ancho-max);
    padding: var(--espacio-5);
    border-radius: var(--radio-lg);
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
}

.explicacion-ubicacion__texto {
    margin: 0 0 var(--espacio-5) 0;
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

.explicacion-ubicacion__botones {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.explicacion-ubicacion__boton {
    min-height: var(--zona-tactil-min);
    min-width: var(--zona-tactil-min);
    margin: var(--espacio-1) 0 0 var(--espacio-2);
    padding: var(--espacio-2) var(--espacio-4);
    border-radius: var(--radio-pill);
    border-width: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.explicacion-ubicacion__boton--secundario,
.explicacion-ubicacion__boton--secundario:hover {
    background-color: var(--color-surface);
    border-color: var(--color-control-edge);
    color: var(--color-text);
}

.explicacion-ubicacion__boton--principal,
.explicacion-ubicacion__boton--principal:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
}

.explicacion-ubicacion__boton--secundario:active {
    background-color: var(--color-surface-2);
}

.explicacion-ubicacion__boton:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

/* Sobre el acento, el foco no se vería con su mismo color */
.explicacion-ubicacion__boton--principal:focus {
    border-color: var(--color-text);
}

/* Puntos de interés de OpenStreetMap (prototipo: lugares.js · addPoiLayer). Cada .poi mide 0×0 y está
   justo en la coordenada (CapaPuntosInteres lo mueve con translate): el círculo queda centrado en ella
   y el nombre a su derecha. Van en una capa por debajo de los marcadores de lugar y no capturan toques. */
.capa-puntos {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.poi {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* Círculo de 24 dp con el color de la categoría, borde y glifo blancos */
.poi__icono {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--poi-icono);
    height: var(--poi-icono);
    translate: -50% -50%;
    border-radius: var(--radio-poi-icono);
    border-width: 2px;
    border-color: var(--color-poi-borde);
    background-color: var(--color-poi-talleres);
    align-items: center;
    justify-content: center;
    color: var(--color-poi-borde);
}

.poi__glifo {
    width: var(--poi-glifo);
    height: var(--poi-glifo);
    color: var(--color-poi-borde);
}

/* Nombre a la derecha del círculo, centrado en vertical, con halo del color de fondo del tema */
.poi__nombre {
    position: absolute;
    left: 14px;
    top: 0;
    translate: 0 -50%;
    max-width: var(--poi-nombre-ancho);
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-left;
    color: var(--color-poi-talleres-texto);
    /* El contorno de TextCore va a caballo del borde de la letra: con más grosor se come el texto de 12 sp */
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: var(--color-bg);
}

.poi--comer .poi__icono { background-color: var(--color-poi-comer); }
.poi--comer .poi__nombre { color: var(--color-poi-comer-texto); }

.poi--rapida .poi__icono { background-color: var(--color-poi-rapida); }
.poi--rapida .poi__nombre { color: var(--color-poi-rapida-texto); }

.poi--cafe .poi__icono { background-color: var(--color-poi-cafe); }
.poi--cafe .poi__nombre { color: var(--color-poi-cafe-texto); }

.poi--bares .poi__icono { background-color: var(--color-poi-bares); }
.poi--bares .poi__nombre { color: var(--color-poi-bares-texto); }

.poi--super .poi__icono { background-color: var(--color-poi-super); }
.poi--super .poi__nombre { color: var(--color-poi-super-texto); }

.poi--tiendas .poi__icono { background-color: var(--color-poi-tiendas); }
.poi--tiendas .poi__nombre { color: var(--color-poi-tiendas-texto); }

.poi--gasolina .poi__icono { background-color: var(--color-poi-gasolina); }
.poi--gasolina .poi__nombre { color: var(--color-poi-gasolina-texto); }

.poi--carga .poi__icono { background-color: var(--color-poi-carga); }
.poi--carga .poi__nombre { color: var(--color-poi-carga-texto); }

.poi--parking .poi__icono { background-color: var(--color-poi-parking); }
.poi--parking .poi__nombre { color: var(--color-poi-parking-texto); }

.poi--hoteles .poi__icono { background-color: var(--color-poi-hoteles); }
.poi--hoteles .poi__nombre { color: var(--color-poi-hoteles-texto); }

.poi--farmacia .poi__icono { background-color: var(--color-poi-farmacia); }
.poi--farmacia .poi__nombre { color: var(--color-poi-farmacia-texto); }

.poi--salud .poi__icono { background-color: var(--color-poi-salud); }
.poi--salud .poi__nombre { color: var(--color-poi-salud-texto); }

.poi--deporte .poi__icono { background-color: var(--color-poi-deporte); }
.poi--deporte .poi__nombre { color: var(--color-poi-deporte-texto); }

.poi--parques .poi__icono { background-color: var(--color-poi-parques); }
.poi--parques .poi__nombre { color: var(--color-poi-parques-texto); }

.poi--cultura .poi__icono { background-color: var(--color-poi-cultura); }
.poi--cultura .poi__nombre { color: var(--color-poi-cultura-texto); }

.poi--bancos .poi__icono { background-color: var(--color-poi-bancos); }
.poi--bancos .poi__nombre { color: var(--color-poi-bancos-texto); }

.poi--belleza .poi__icono { background-color: var(--color-poi-belleza); }
.poi--belleza .poi__nombre { color: var(--color-poi-belleza-texto); }

.poi--talleres .poi__icono { background-color: var(--color-poi-talleres); }
.poi--talleres .poi__nombre { color: var(--color-poi-talleres-texto); }

.poi--transporte .poi__icono { background-color: var(--color-poi-transporte); }
.poi--transporte .poi__nombre { color: var(--color-poi-transporte-texto); }

.poi--educacion .poi__icono { background-color: var(--color-poi-educacion); }
.poi--educacion .poi__nombre { color: var(--color-poi-educacion-texto); }

.poi--publico .poi__icono { background-color: var(--color-poi-publico); }
.poi--publico .poi__nombre { color: var(--color-poi-publico-texto); }

.poi--culto .poi__icono { background-color: var(--color-poi-culto); }
.poi--culto .poi__nombre { color: var(--color-poi-culto-texto); }

/* Ficha del lugar (historia 1.8; DESIGN components.sheet; mockups/key-ficha-lugar.html). El hueco y la ficha
   cubren la pantalla sin capturar toques; el velo (transparente) los captura con la ficha abierta y la hoja
   opaca va anclada abajo, con como mucho el 72 % del alto y desplazamiento interno. */
.hueco-ficha,
.ficha,
.ficha__velo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ficha__hoja {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: var(--ficha-alto-max);
    padding-top: var(--espacio-4);
    background-color: var(--color-surface);
    border-top-left-radius: var(--radio-sheet);
    border-top-right-radius: var(--radio-sheet);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: var(--color-border);
}

.ficha__cabecera {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    padding: 0 var(--espacio-4);
}

.ficha__cabecera-textos {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--espacio-3);
}

.ficha__titulo {
    margin: 0;
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

.ficha__linea-tipo {
    flex-direction: row;
    align-items: center;
    margin-top: var(--espacio-1);
}

.ficha__muestra {
    width: var(--muestra-plantilla);
    height: var(--muestra-plantilla);
    flex-shrink: 0;
    margin-right: var(--espacio-2);
    border-radius: 3px;
    background-color: var(--color-pin-servicio);
}

/* Gotita del punto libre (historia 2.5, maqueta): la gota de la chincheta en 12 × 14, sin borde. Su color es el del
   centro; el del cuerpo, el de su hijo, que la dibuja (los mismos tokens de la chincheta) */
.ficha__gota {
    width: var(--gotita-ancho);
    height: var(--gotita-alto);
    flex-shrink: 0;
    margin-right: var(--espacio-2);
    color: var(--color-chincheta-detalle);
}

.ficha__gota-cuerpo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--color-chincheta);
}

.ficha__muestra--hosteleria { background-color: var(--color-pin-hosteleria); }
.ficha__muestra--ocio { background-color: var(--color-pin-ocio); }

.ficha__tipo {
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

.ficha__direccion {
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.ficha__cerrar {
    flex-shrink: 0;
    background-color: var(--color-surface-2);
}

/* Fila de acciones (FR-10): bajo la cabecera, fuera del contenido, siempre a la vista. Sin rutas, vacía y sin alto */
.ficha__acciones {
    flex-direction: row;
    flex-shrink: 0;
}

/* Modos e Ir (historia 2.6; maqueta key-ficha-lugar .actions): dos modos de 48 dp con borde de control y el botón
   primario Ir de 52 dp (flex 1,2), separados 8 dp */
.acciones {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    align-items: center;
    margin: var(--espacio-3) var(--espacio-4) 0 var(--espacio-4);
}

.acciones__modo {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: var(--zona-tactil-min);
    margin-right: var(--espacio-2);
    padding: var(--espacio-1) var(--espacio-1);
    align-items: center;
    justify-content: center;
    border-radius: var(--radio-md);
    border-width: 1.5px;
    border-color: var(--color-control-edge);
    background-color: var(--color-surface);
    color: var(--color-text);
}

.acciones__modo:active {
    background-color: var(--color-surface-2);
}

.acciones__modo--elegido {
    border-color: var(--color-accent);
    background-color: var(--color-surface-2);
    color: var(--color-accent-text);
}

.acciones__modo:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

.acciones__modo-linea {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.acciones__modo-icono {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: var(--espacio-1);
}

.acciones__modo-nombre,
.acciones__modo-tiempo {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.acciones__modo-nombre {
    color: var(--color-text);
}

.acciones__modo--elegido .acciones__modo-nombre {
    color: var(--color-accent-text);
}

.acciones__modo-tiempo {
    color: var(--color-muted);
}

.acciones__modo--elegido .acciones__modo-tiempo {
    color: var(--color-accent-text);
}

.acciones__ir {
    flex-grow: 1.2;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 var(--espacio-4);
    border-radius: var(--radio-md);
    border-width: 2px;
    border-color: var(--color-accent);
    background-color: var(--color-accent);
}

/* Sobre el acento, el foco no se vería con su mismo color */
.acciones__ir:focus {
    border-color: var(--color-text);
}

.acciones__ir-texto {
    margin: 0;
    padding: 0;
    color: var(--color-accent-ink);
    -unity-text-align: middle-center;
}

.ficha__contenido {
    flex-shrink: 1;
    margin-top: var(--espacio-2);
}

/* Sin el tema por defecto de Unity, lo que necesita el ScrollView para recortar y desplazarse */
.ficha__contenido .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.ficha__contenido .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* El contenido mide lo que suman sus filas y se desplaza dentro del viewport. Sin el tema por defecto, el
   contenedor encogía (flex-shrink 1) hasta el alto del viewport y, con él, cada fila y cada encabezado: los
   textos se dibujaban fuera de su caja, montados sobre la fila siguiente. Ni el contenedor ni sus hijos encogen. */
.ficha__contenido .unity-scroll-view__content-container {
    flex-shrink: 0;
    padding: 0 var(--espacio-4) var(--espacio-4) var(--espacio-4);
}

.ficha__area,
.ficha__concepto,
.ficha__sin-precio,
.ficha__concepto-izquierda > *,
.ficha__concepto-derecha > * {
    flex-shrink: 0;
}

.ficha__area {
    margin: var(--espacio-4) 0 var(--espacio-1) 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.ficha__concepto {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--espacio-3) 0;
    border-top-width: 1px;
    border-color: var(--color-border);
}

.ficha__concepto-izquierda {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--espacio-3);
}

.ficha__concepto-derecha {
    flex-shrink: 0;
    max-width: 50%;
    align-items: flex-end;
}

.ficha__concepto-nombre {
    margin: 0;
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

.ficha__origen {
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.ficha__frescura {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.ficha__frescura-punto {
    width: var(--frescura-punto);
    height: var(--frescura-punto);
    flex-shrink: 0;
    margin-right: 5px;
    border-radius: var(--radio-frescura-punto);
}

.ficha__frescura-punto--al-dia { background-color: var(--color-fresh-al-dia); }
.ficha__frescura-punto--podria { background-color: var(--color-fresh-podria); }
.ficha__frescura-punto--antiguo { background-color: var(--color-fresh-antiguo); }

.ficha__frescura-texto {
    margin: 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.ficha__precio {
    margin: 0;
    padding: 0;
    color: var(--color-accent);
    white-space: normal;
    -unity-text-align: upper-right;
}

.ficha__precio--consultar {
    color: var(--color-muted);
}

.ficha__unidad {
    margin: 0;
    padding: 0;
    color: var(--color-muted);
    -unity-text-align: upper-right;
}

/* Variantes (historia 1.8, parte 2; maqueta .variant y .now): debajo del nombre, condición en muted y precio en
   color de texto; la vigente lleva delante el chip "Ahora" (surface-2, accent, peso 800). */
.ficha__variante {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--espacio-1);
}

.ficha__variante-ahora {
    margin: 0 6px 0 0;
    padding: 2px 6px;
    border-radius: var(--radio-xs);
    background-color: var(--color-surface-2);
    color: var(--color-ahora-texto);
}

.ficha__variante-condicion,
.ficha__variante-separador {
    margin: 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.ficha__variante-separador {
    margin: 0 4px;
}

.ficha__variante-precio {
    margin: 0;
    padding: 0;
    color: var(--color-text);
}

.ficha__sin-precio {
    margin: var(--espacio-4) 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

/* Buscador (historia 2.2; DESIGN components.capsule y sheet; prototipo .dock). El hueco cubre la pantalla sin capturar
   toques. La cápsula y la hoja son el mismo elemento: HojaBuscador le pone desde el código top, márgenes, esquinas y
   relleno según la fracción abierta; aquí van los valores de la cápsula plegada antes de medir y la transición de
   0,32 s (sin transición mientras el dedo arrastra). */
.hueco-buscador {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.buscador {
    position: absolute;
    left: var(--espacio-3);
    right: var(--espacio-3);
    bottom: 20px;
    min-height: var(--capsula-alto-min);
    padding: 5px;
    flex-direction: column;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    background-color: var(--color-capsula);
    transition-property: top, left, right, bottom, height, padding-top, padding-bottom, padding-left, padding-right,
        border-top-left-radius, border-top-right-radius, border-bottom-left-radius, border-bottom-right-radius, background-color;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-cubic;
}

.buscador--arrastrando {
    transition-duration: 0s;
}

/* "Quitar animaciones" del sistema (UX-DR19): la hoja cambia de altura sin transición */
.buscador--sin-transicion {
    transition-duration: 0s;
}

/* "Expandir" y "Contraer" de TalkBack: no se ven; solo dan el marco de su nodo (mitades de la zona del tirador) */
.buscador__solo-lector {
    position: absolute;
    top: 0;
    width: 50%;
    height: var(--espacio-5);
}

.buscador__expandir {
    left: 0;
}

.buscador__contraer {
    right: 0;
}

/* Abierta (desde el 15 %): fondo opaco de superficie */
.buscador--abierta {
    background-color: var(--color-surface);
}

/* Tirador: plegada va encima del borde superior sin ocupar sitio (36 × 3); abierta tiene su propio hueco (40 × 5) */
.buscador__asa-zona {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 5px;
    padding-top: 1px;
    align-items: center;
}

.buscador__asa {
    width: 36px;
    height: 3px;
    border-radius: 2px;
    background-color: var(--color-border);
    flex-shrink: 0;
}

.buscador--abierta .buscador__asa-zona {
    height: var(--espacio-5);
    padding-top: 9px;
}

.buscador--abierta .buscador__asa {
    width: 40px;
    height: 5px;
    border-radius: 2.5px;
}

/* Lo de dentro se recorta: plegada solo se ve la línea del campo */
.buscador__interior {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.buscador__linea {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.buscador__campo {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-height: var(--buscador-campo-alto);
    min-width: 0;
    overflow: hidden;
    padding: 0 var(--espacio-3);
    border-radius: var(--radio-buscador-campo);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--color-buscador-campo);
}

.buscador--abierta .buscador__campo {
    border-color: var(--color-accent);
}

.buscador__lupa {
    width: var(--buscador-lupa);
    height: var(--buscador-lupa);
    flex-shrink: 0;
    margin-right: var(--espacio-2);
    color: var(--color-muted);
}

/* Campo de texto sin el tema por defecto de Unity: sin fondo ni borde propios; el texto vacío ("Buscar en Sanlúcar")
   en muted */
.buscador__texto {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0; /* un texto largo (un enlace pegado) no estira el campo: se recorta dentro, antes de la X */
    overflow: hidden;
    margin: 0;
    padding: 0;
    color: var(--color-text);
}

.buscador__texto .unity-base-text-field__input {
    min-width: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text);
    --unity-cursor-color: var(--color-accent);
    --unity-selection-color: var(--color-accent-soft);
}

.buscador__texto .unity-base-text-field__input--placeholder {
    color: var(--color-muted);
}

/* Avatar genérico de 40 dp (aún no hace nada: el perfil es de la historia 3.5) */
.buscador__avatar {
    width: var(--avatar);
    height: var(--avatar);
    flex-shrink: 0;
    margin-left: var(--espacio-2);
    border-radius: var(--radio-avatar);
    border-width: 2px;
    border-color: var(--color-border);
    background-color: var(--color-surface-2);
    align-items: center;
    justify-content: center;
}

.buscador__avatar-glifo {
    width: var(--avatar-glifo);
    height: var(--avatar-glifo);
    color: var(--color-accent-text);
}

/* Contenido de la hoja: categorías y "Encuentra cerca" (lo que se ve antes de escribir) */
.buscador__panel {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: var(--espacio-1);
}

.buscador__panel .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.buscador__panel .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.buscador__panel .unity-scroll-view__content-container {
    flex-shrink: 0;
    padding: var(--espacio-3) 2px var(--espacio-5) 2px;
}

.buscador__chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

/* Chip de categoría: 40 dp de alto mínimo, borde de 1,5 y el icono de su categoría de punto de interés */
.buscador__chip {
    flex-direction: row;
    align-items: center;
    min-height: var(--chip-alto-min);
    margin: 0 var(--espacio-2) var(--espacio-2) 0;
    padding: var(--espacio-1) var(--espacio-3) var(--espacio-1) 6px;
    border-radius: var(--radio-chip);
    border-width: 1.5px;
    border-color: var(--color-border);
}

.buscador__chip-icono {
    width: var(--chip-icono);
    height: var(--chip-icono);
    flex-shrink: 0;
    border-radius: var(--radio-chip-icono);
    align-items: center;
    justify-content: center;
    background-color: var(--color-poi-talleres);
}

.buscador__chip-icono--comer { background-color: var(--color-poi-comer); }
.buscador__chip-icono--bares { background-color: var(--color-poi-bares); }
.buscador__chip-icono--super { background-color: var(--color-poi-super); }
.buscador__chip-icono--farmacia { background-color: var(--color-poi-farmacia); }
.buscador__chip-icono--gasolina { background-color: var(--color-poi-gasolina); }
.buscador__chip-icono--deporte { background-color: var(--color-poi-deporte); }
.buscador__chip-icono--salud { background-color: var(--color-poi-salud); }
.buscador__chip-icono--cultura { background-color: var(--color-poi-cultura); }

.buscador__chip-glifo {
    width: var(--chip-glifo);
    height: var(--chip-glifo);
    color: var(--color-poi-borde);
}

.buscador__chip-texto {
    flex-shrink: 1;
    margin: 0 0 0 var(--espacio-2);
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

/* "Encuentra cerca" (prototipo .near-list): fila de 52 dp sobre surface-2 */
.buscador__cerca {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--cerca-alto-min);
    margin-top: var(--espacio-2);
    padding: var(--espacio-2) var(--espacio-4);
    border-radius: var(--radio-lg);
    background-color: var(--color-surface-2);
}

.buscador__cerca-glifo {
    width: var(--cerca-glifo);
    height: var(--cerca-glifo);
    flex-shrink: 0;
    color: var(--color-accent-text);
}

.buscador__cerca-texto {
    flex-shrink: 1;
    margin: 0 0 0 var(--espacio-3);
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

/* ───────── Búsqueda (historia 2.3) ───────── */

/* La X del campo: solo con texto (la muestra el código); 36 dp de zona táctil dentro del campo de 46 */
.buscador__borrar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-left: var(--espacio-1);
    margin-right: -6px;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
}

.buscador__borrar-glifo {
    width: 18px;
    height: 18px;
    color: var(--color-muted);
}

.buscador__resultados {
    flex-shrink: 0;
}

/* ───────── Encuentra cerca (historia 2.4) ───────── */

/* Cabecera de la lista: título (y "desde el centro del mapa") a la izquierda y la X de 48 dp a la derecha */
.buscador__cabecera-cerca {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 48px;
    padding: 0 0 0 var(--espacio-1);
    border-bottom-width: 1px;
    border-color: var(--color-border);
}

.buscador__cabecera-cerca-textos {
    flex-grow: 1;
    flex-shrink: 1;
}

.buscador__titulo-cerca {
    margin: 0;
    padding: 0;
    color: var(--color-text);
    -unity-font-style: bold;
    white-space: normal;
}

.buscador__desde-centro {
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.buscador__quitar-categoria {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 24px;
    align-items: center;
    justify-content: center;
}

.buscador__quitar-categoria-glifo {
    width: 20px;
    height: 20px;
    color: var(--color-muted);
}

/* Fila de resultado (prototipo .result): icono de 36, nombre, tipo y distancia debajo y el precio a la derecha */
.buscador__resultado {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 56px;
    padding: var(--espacio-2) var(--espacio-1);
    border-bottom-width: 1px;
    border-color: var(--color-border);
}

.buscador__resultado-icono {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-poi-talleres);
}

.buscador__resultado-glifo {
    width: 19px;
    height: 19px;
    color: var(--color-poi-borde);
}

/* Lugares de la app: el logo de su tipo en acento sobre surface-2 */
.buscador__resultado-icono--lugar { background-color: var(--color-surface-2); }
.buscador__resultado-icono--lugar .buscador__resultado-glifo { color: var(--color-accent-text); }

.buscador__resultado-icono--comer { background-color: var(--color-poi-comer); }
.buscador__resultado-icono--rapida { background-color: var(--color-poi-rapida); }
.buscador__resultado-icono--cafe { background-color: var(--color-poi-cafe); }
.buscador__resultado-icono--bares { background-color: var(--color-poi-bares); }
.buscador__resultado-icono--super { background-color: var(--color-poi-super); }
.buscador__resultado-icono--tiendas { background-color: var(--color-poi-tiendas); }
.buscador__resultado-icono--gasolina { background-color: var(--color-poi-gasolina); }
.buscador__resultado-icono--carga { background-color: var(--color-poi-carga); }
.buscador__resultado-icono--parking { background-color: var(--color-poi-parking); }
.buscador__resultado-icono--hoteles { background-color: var(--color-poi-hoteles); }
.buscador__resultado-icono--farmacia { background-color: var(--color-poi-farmacia); }
.buscador__resultado-icono--salud { background-color: var(--color-poi-salud); }
.buscador__resultado-icono--deporte { background-color: var(--color-poi-deporte); }
.buscador__resultado-icono--parques { background-color: var(--color-poi-parques); }
.buscador__resultado-icono--cultura { background-color: var(--color-poi-cultura); }
.buscador__resultado-icono--bancos { background-color: var(--color-poi-bancos); }
.buscador__resultado-icono--belleza { background-color: var(--color-poi-belleza); }
.buscador__resultado-icono--talleres { background-color: var(--color-poi-talleres); }
.buscador__resultado-icono--transporte { background-color: var(--color-poi-transporte); }
.buscador__resultado-icono--educacion { background-color: var(--color-poi-educacion); }
.buscador__resultado-icono--publico { background-color: var(--color-poi-publico); }
.buscador__resultado-icono--culto { background-color: var(--color-poi-culto); }

.buscador__resultado-textos {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 var(--espacio-3);
}

.buscador__resultado-nombre {
    margin: 0;
    padding: 0;
    color: var(--color-text);
    white-space: normal;
}

.buscador__resultado-detalle {
    margin: 2px 0 0 0;
    padding: 0;
    color: var(--color-muted);
    white-space: normal;
}

.buscador__resultado-precio {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: var(--color-accent-text);
}

/* Direcciones (historia 2.3, parte 2): el pin en el color del texto sobre surface-2 */
.buscador__resultado-icono--direccion { background-color: var(--color-surface-2); }
.buscador__resultado-icono--direccion .buscador__resultado-glifo { color: var(--color-text); }

/* «Ir a este punto» (historia 2.5, parte 2; maqueta del 20/11/2026): la chincheta en negativo, el círculo del color de
   la chincheta y la gota del de su detalle (claro: círculo azul marino y gota blanca; oscuro, al revés). La gota
   guarda la proporción de la chincheta (34 × 44) */
.buscador__resultado-icono--coordenada { background-color: var(--color-chincheta); }
.buscador__resultado-icono--coordenada .buscador__resultado-glifo { color: var(--color-chincheta-detalle); }
.buscador__resultado-glifo--chincheta {
    width: 15px;
    height: 19px;
}

/* "No hay resultados" y, a su lado, "Buscar como dirección" (baja de línea si no cabe) */
.buscador__fila-sin-resultados {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.buscador__sin-resultados {
    flex-shrink: 1;
    margin: 0;
    padding: 14px var(--espacio-1);
    color: var(--color-muted);
    white-space: normal;
}

/* Botón de texto con zona táctil de 48 dp */
.buscador__buscar-direccion {
    flex-shrink: 0;
    min-height: 48px;
    min-width: 48px;
    padding: 0 var(--espacio-3);
    border-radius: var(--radio-lg);
    justify-content: center;
    align-items: center;
    background-color: var(--color-surface-2);
}

.buscador__buscar-direccion-texto {
    margin: 0;
    padding: 0;
    color: var(--color-accent-text);
    white-space: normal;
}

/* "Las direcciones necesitan conexión", bajo la lista */
.buscador__aviso-direcciones {
    flex-shrink: 0;
    margin: 0;
    padding: var(--espacio-2) var(--espacio-1);
    color: var(--color-muted);
    white-space: normal;
}
