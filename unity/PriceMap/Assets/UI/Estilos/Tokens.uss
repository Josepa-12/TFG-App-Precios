/* Tokens de DESIGN.md traducidos a variables USS (UX-DR1 a UX-DR3).
   Ningún color, tipografía, espaciado ni radio fuera de este fichero.
   1 px del panel = 1 dp (PanelSettings de tamaño físico constante a 160 dpi);
   los tamaños de letra se multiplican por la escala de fuente del sistema (EscalaFuente) = sp. */

.pm-raiz {
    /* Paleta B (tema claro) */
    --color-bg: #F3F5FB;
    --color-surface: #FFFFFF;
    --color-surface-2: #EEF2FC;
    --color-border: #D3DCF2;
    --color-text: #13235B;
    --color-muted: #4B5878;
    --color-accent: #2F5BEA;
    --color-accent-ink: #FFFFFF;
    --color-accent-soft: #D3DCF2;
    --color-reward: #FFC93C;
    --color-reward-ink: #13235B;
    --color-reward-edge: #C99300;
    --color-success: #0E7A4F;
    --color-danger: #D6334A;
    --color-control-edge: #6E7A99;
    --color-focus: #2F5BEA;
    --color-ahora-texto: #2F5BEA; /* chip "Ahora" de la variante vigente sobre surface-2 */
    /* Cristal de los controles flotantes: 0,90 (el prototipo usa 0,74 con desenfoque). Unity no difumina
       lo de detrás, así que los nombres de calle del mapa, que no se ocultan, apenas se leen debajo.
       Mínimo medido sobre los colores del mapa (PruebasContraste): icono --color-accent-text 5,11:1, texto 13,7:1,
       muted 6,56:1, borde del control 3,96:1 (con 0,76 el icono daba 4,57:1) */
    --color-glass: rgba(255, 255, 255, 0.90);
    --color-glass-edge: rgba(255, 255, 255, 0.9);   /* borde casi invisible del cristal (prototipo --glass-edge) */
    --color-accent-text: #2F5BEA;                    /* iconos de la columna de controles (prototipo --accent-text) */
    --color-sombra: rgba(19, 35, 91, 0.16);          /* sombra suave de los controles (prototipo --shadow) */
    --color-tpl-servicio: #2F5BEA;
    --color-tpl-hosteleria: #E07B12;
    --color-tpl-ocio: #1F9D6B;
    --color-fresh-al-dia: #0E7A4F;
    --color-fresh-podria: #A87A00;
    --color-fresh-antiguo: #6E7A99;
    --color-map-fondo: #E9EDF7;
    /* Marcadores de los lugares: iguales en los dos temas (decisión del 17/11/2026), por eso no se
       redefinen en .tema-oscuro; el logo y el borde blancos van encima */
    --color-pin-servicio: #2F5BEA;
    --color-pin-hosteleria: #D6740F; /* más oscuro que --color-tpl-hosteleria: logo blanco ≥ 3:1 */
    --color-pin-ocio: #1F9D6B;
    --color-pin-borde: #FFFFFF;
    /* Posición del usuario (historia 1.7): círculo #2F5BEA con borde blanco y cono translúcido del mismo
       azul; igual en los dos temas, como los marcadores */
    --color-posicion: #2F5BEA;
    --color-posicion-borde: #FFFFFF;
    --color-posicion-cono: rgba(47, 91, 234, 0.28);
    /* Flecha de la navegación en coche (historia 2.7, parte 2c): mismo azul, sin borde, sobre un disco
       blanco (--color-posicion-borde); en oscuro, más clara */
    --color-flecha: #2F5BEA;
    /* Chincheta del punto libre (historia 2.5, maqueta del 19/11/2026): azul marino (--color-text del claro) con
       borde y centro blancos; en oscuro, blanca con borde fino y centro azul marino. Sombra pequeña en el suelo */
    --color-chincheta: #13235B;
    --color-chincheta-detalle: #FFFFFF;
    --color-chincheta-sombra: rgba(19, 35, 91, 0.28);
    /* Velo detrás de una ventana modal (explicación del permiso de ubicación) */
    --color-velo-modal: rgba(15, 20, 36, 0.45);
    /* Puntos de interés de OpenStreetMap (prototipo/lugares.js · POI_CATS): el círculo es igual en los
       dos temas; el nombre (-texto) va oscurecido un 30 % en el claro y aclarado un 35 % en el oscuro
       (shade del prototipo), con un halo de --color-bg; si así no llega a 4,5:1 sobre el fondo del
       mapa, se oscurece algo más (comer, super) */
    --color-poi-comer: #F07D1A;
    --color-poi-rapida: #E5541F;
    --color-poi-cafe: #9B6A3C;
    --color-poi-bares: #D6336C;
    --color-poi-super: #D99A00;
    --color-poi-tiendas: #C9821A;
    --color-poi-gasolina: #2F7DE1;
    --color-poi-carga: #16A36A;
    --color-poi-parking: #3B63D9;
    --color-poi-hoteles: #7A5AF0;
    --color-poi-farmacia: #E5484D;
    --color-poi-salud: #C93434;
    --color-poi-deporte: #0E9FB0;
    --color-poi-parques: #2E9E5B;
    --color-poi-cultura: #A33FD1;
    --color-poi-bancos: #4D7C6B;
    --color-poi-belleza: #E0609A;
    --color-poi-talleres: #6B7280;
    --color-poi-transporte: #4B5B7C;
    --color-poi-educacion: #8C6E4E;
    --color-poi-publico: #64748B;
    --color-poi-culto: #7C7C8A;
    --color-poi-borde: #FFFFFF;
    --color-poi-comer-texto: #A35512; /* -32 %: con -30 % no llega a 4,5:1 sobre el fondo del mapa */
    --color-poi-rapida-texto: #A03B16;
    --color-poi-cafe-texto: #6C4A2A;
    --color-poi-bares-texto: #96244C;
    --color-poi-super-texto: #8B6300; /* -36 %: con -30 % no llega a 4,5:1 sobre el fondo del mapa */
    --color-poi-tiendas-texto: #8D5B12;
    --color-poi-gasolina-texto: #21589E;
    --color-poi-carga-texto: #0F724A;
    --color-poi-parking-texto: #294598;
    --color-poi-hoteles-texto: #553FA8;
    --color-poi-farmacia-texto: #A03236;
    --color-poi-salud-texto: #8D2424;
    --color-poi-deporte-texto: #0A6F7B;
    --color-poi-parques-texto: #206F40;
    --color-poi-cultura-texto: #722C92;
    --color-poi-bancos-texto: #36574B;
    --color-poi-belleza-texto: #9D436C;
    --color-poi-talleres-texto: #4B505A;
    --color-poi-transporte-texto: #344057;
    --color-poi-educacion-texto: #624D37;
    --color-poi-publico-texto: #465161;
    --color-poi-culto-texto: #575761;
    /* Buscador (historia 2.2): la cápsula es de cristal en claro y opaca en oscuro; el campo, surface en claro y
       surface-2 en oscuro (prototipo .search) */
    --color-capsula: rgba(255, 255, 255, 0.90);
    --color-buscador-campo: #FFFFFF;
    /* Tarjeta de acciones de la ruta (historia 2.6, parte 2a; maqueta v2 del 20/11/2026): text al 96 % con texto
       blanco en claro; clara con texto bg en oscuro, para destacar sobre el mapa. -meta, la maniobra siguiente */
    --color-tarjeta-maniobra: rgba(19, 35, 91, 0.96);
    --color-tarjeta-maniobra-texto: #FFFFFF;
    --color-tarjeta-maniobra-meta: #B8C4EA;
    /* Toast (DESIGN.md · Toast; historia 2.6, parte 2b): fondo text, texto bg, para contrastar con todo */
    --color-toast: #13235B;
    --color-toast-texto: #F3F5FB;

    /* Espaciado (4 / 8 / 12 / 16 / 24 / 32) */
    --espacio-1: 4px;
    --espacio-2: 8px;
    --espacio-3: 12px;
    --espacio-4: 16px;
    --espacio-5: 24px;
    --espacio-6: 32px;

    /* Radios */
    --radio-xs: 6px;
    --radio-sm: 10px;
    --radio-md: 14px;
    --radio-lg: 18px;
    --radio-sheet: 24px;
    /* Píldoras y círculos: la mitad del alto (UI Toolkit no reduce un radio enorme como CSS: daría un óvalo).
       Fijos para los círculos; la píldora y los botones de la ventana de ubicación lo ajustan con Semicirculo al
       alto real (24 = mitad de los 48 dp mínimos, hasta que se disponen) */
    --radio-pill: 24px;
    --radio-boton-redondo: 24px;   /* 48 / 2 */
    --radio-insignia: 9px;         /* 18 / 2 */
    --radio-posicion-punto: 12px;  /* 24 / 2 */
    --radio-posicion-disco: 24px;  /* 48 / 2 */
    --radio-poi-icono: 12px;       /* 24 / 2 */
    --radio-frescura-punto: 4.5px; /* 9 / 2 */
    --radio-toast: 12px;     /* toast (DESIGN.md) */
    --radio-columna: 16px;   /* columna de controles (prototipo .ctrl-stack) */
    --radio-opcion: 12px;    /* opciones del menú "Precios" (prototipo .cat-menu button) */

    /* Tamaños de componentes (mínimos) */
    --boton-redondo: 48px;
    --menu-precios-ancho: 220px;
    --menu-precios-relleno: 6px;
    --zona-tactil-min: 48px;
    --marcador: 42px;
    --marcador-sin-precio: 32px;
    --marcador-logo: 22px;
    --marcador-logo-sin-precio: 17px;
    --marcador-insignia: 18px;
    --poi-icono: 24px;
    --poi-glifo: 13px;
    --poi-nombre-ancho: 96px; /* 8 em de 12 sp, como text-max-width del prototipo */
    /* Cursor de la posición más grande (maqueta B del 22/11/2026): punto de 24 con borde de 4, cono de 100 y, en
       coche, flecha de 30 sobre un disco blanco de 48 con sombra suave */
    --posicion-punto: 24px;
    --posicion-punto-borde: 4px;
    --posicion-cono: 100px;
    --posicion-flecha: 30px;
    --posicion-disco: 48px;
    --chincheta-ancho: 34px;
    --chincheta-alto: 44px;
    --gotita-ancho: 12px;  /* gotita delante de "Punto en el mapa" */
    --gotita-alto: 14px;
    --modal-ancho-max: 360px;
    /* Ficha del lugar (historia 1.8; DESIGN components.sheet) */
    --ficha-alto-max: 72%;
    --muestra-plantilla: 10px;
    --frescura-punto: 9px;
    /* Buscador (historia 2.2; DESIGN components.capsule y sheet; prototipo .dock): cápsula de 56 dp como mínimo
       (5 + campo de 46 + 5), avatar de 40 dp, chips de 40 dp con icono de 24 dp y "Encuentra cerca" de 52 dp */
    --capsula-alto-min: 56px;
    --buscador-campo-alto: 46px;
    --radio-buscador-campo: 23px;  /* 46 / 2 */
    --buscador-lupa: 18px;
    --avatar: 40px;
    --radio-avatar: 20px;          /* 40 / 2 */
    --avatar-glifo: 22px;
    --chip-alto-min: 40px;
    --radio-chip: 20px;            /* 40 / 2 */
    --chip-icono: 24px;
    --radio-chip-icono: 12px;      /* 24 / 2 */
    --chip-glifo: 13px;
    --cerca-alto-min: 52px;
    --cerca-glifo: 22px;
    /* Tarjetas de la ruta (historia 2.6, parte 2a): flecha de la maniobra (28 dp) y de la siguiente (20 dp), asa */
    --maniobra-icono: 28px;
    --maniobra-icono-siguiente: 20px;
    --asa-ancho: 36px;
    --asa-alto: 4px;

    -unity-font: url("../Fuentes/NunitoSans-Regular.ttf");
    color: var(--color-text);
}

/* Paleta D (tema oscuro): cada token con su par -dark */
.pm-raiz.tema-oscuro {
    --color-bg: #0F1424;
    --color-surface: #1A2238;
    --color-surface-2: #232D49;
    --color-border: #2A3A63;
    --color-text: #E6ECFA;
    --color-muted: #9AA6C4;
    --color-accent: #4C7DFF;
    --color-accent-ink: #0B1020;
    --color-accent-soft: #2A3A63;
    --color-reward: #FFD166;
    --color-reward-ink: #1A1300;
    --color-reward-edge: #C99A2E;
    --color-success: #4ADE9B;
    --color-danger: #FF6B81;
    --color-control-edge: #7F8BAA;
    --color-focus: #8FB0FF;
    --color-ahora-texto: #8FB0FF; /* el acento oscuro no llega a 4,5:1 sobre surface-2 */
    /* 0,90 como en claro: sin desenfoque, lo de debajo apenas se lee. Mínimo sobre los colores del mapa: icono
       --color-accent-text 7,16:1, texto 12,9:1, muted 6,29:1, borde del control 4,5:1 */
    --color-glass: rgba(26, 34, 56, 0.90);
    --color-glass-edge: rgba(76, 125, 255, 0.28);
    --color-accent-text: #8FB0FF;   /* el acento oscuro (#4C7DFF) no llega a 4,5:1 sobre el cristal al 0,90 (4,15:1) */
    --color-sombra: rgba(0, 0, 0, 0.45);
    --color-tpl-servicio: #4C7DFF;
    --color-tpl-hosteleria: #F59A3C;
    --color-tpl-ocio: #3DD69B;
    --color-fresh-al-dia: #4ADE9B;
    --color-fresh-podria: #FFD166;
    --color-fresh-antiguo: #7F8BAA;
    --color-map-fondo: #141B30;
    --color-chincheta: #FFFFFF;
    --color-chincheta-detalle: #13235B;
    --color-chincheta-sombra: rgba(0, 0, 0, 0.45);
    --color-flecha: #4C7DFF;
    --color-poi-comer-texto: #F5AA6A;
    --color-poi-rapida-texto: #EE906D;
    --color-poi-cafe-texto: #BE9E80;
    --color-poi-bares-texto: #E47A9F;
    --color-poi-super-texto: #E6BD59;
    --color-poi-tiendas-texto: #DCAE6A;
    --color-poi-gasolina-texto: #78AAEC;
    --color-poi-carga-texto: #68C39E;
    --color-poi-parking-texto: #809AE6;
    --color-poi-hoteles-texto: #A994F5;
    --color-poi-farmacia-texto: #EE888B;
    --color-poi-salud-texto: #DC7B7B;
    --color-poi-deporte-texto: #62C1CC;
    --color-poi-parques-texto: #77C094;
    --color-poi-cultura-texto: #C382E1;
    --color-poi-bancos-texto: #8BAA9F;
    --color-poi-belleza-texto: #EB98BD;
    --color-poi-talleres-texto: #9FA3AC;
    --color-poi-transporte-texto: #8A94AA;
    --color-poi-educacion-texto: #B4A18C;
    --color-poi-publico-texto: #9AA5B4;
    --color-poi-culto-texto: #AAAAB3;
    --color-capsula: #1A2238;        /* opaca en oscuro (surface) */
    --color-buscador-campo: #232D49; /* surface-2 */
    --color-tarjeta-maniobra: #E6ECFA;
    --color-tarjeta-maniobra-texto: #0F1424; /* bg oscuro */
    --color-tarjeta-maniobra-meta: #3E4D78;
    --color-toast: #E6ECFA;        /* text oscuro */
    --color-toast-texto: #0F1424;  /* bg oscuro */
}

/* Tipografía: Varela Round para títulos, Nunito Sans para el resto (tamaños en dp, escalados a sp) */
.t-display { -unity-font: url("../Fuentes/VarelaRound-Regular.ttf"); font-size: 26px; }
.t-title { -unity-font: url("../Fuentes/VarelaRound-Regular.ttf"); font-size: 20px; }
.t-heading { -unity-font: url("../Fuentes/VarelaRound-Regular.ttf"); font-size: 17px; }
.t-body { -unity-font: url("../Fuentes/NunitoSans-Regular.ttf"); font-size: 16px; }
.t-label { -unity-font: url("../Fuentes/NunitoSans-ExtraBold.ttf"); font-size: 14px; }
.t-meta { -unity-font: url("../Fuentes/NunitoSans-SemiBold.ttf"); font-size: 13px; }
.t-meta-fuerte { -unity-font: url("../Fuentes/NunitoSans-ExtraBold.ttf"); font-size: 13px; }
/* Título del menú "Precios" (prototipo .menu-title): 11 px, 800, espaciado 0,05 em = 0,55 px; mayúsculas desde el código */
.t-titulo-menu { -unity-font: url("../Fuentes/NunitoSans-ExtraBold.ttf"); font-size: 11px; letter-spacing: 0.55px; }
.t-caption { -unity-font: url("../Fuentes/NunitoSans-SemiBold.ttf"); font-size: 12px; }
/* Maniobra de la ruta (tarjeta de acciones, historia 2.6 parte 2a): 20 sp, 800 */
.t-maniobra { -unity-font: url("../Fuentes/NunitoSans-ExtraBold.ttf"); font-size: 20px; }
.t-price { -unity-font: url("../Fuentes/NunitoSans-ExtraBold.ttf"); font-size: 22px; }
