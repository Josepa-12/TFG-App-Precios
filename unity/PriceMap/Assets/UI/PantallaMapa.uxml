<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Estilos/Tokens.uss" />
    <Style src="PantallaMapa.uss" />
    <!-- El mapa ocupa toda la pantalla y los controles flotan encima (DESIGN.md · Layout).
         Los contenedores no capturan toques para que el mapa siga respondiendo a los gestos. -->
    <ui:VisualElement name="raiz" class="pm-raiz" picking-mode="Ignore">
        <!-- Puntos de interés de OpenStreetMap (CapaPuntosInteres): debajo de los marcadores de lugar y sin capturar toques -->
        <ui:VisualElement name="capa-puntos" class="capa-puntos" picking-mode="Ignore" />
        <!-- Marcadores de los lugares (CapaMarcadores): debajo de los controles y sin capturar toques -->
        <ui:VisualElement name="capa-marcadores" class="capa-marcadores" picking-mode="Ignore" />
        <!-- Posición del usuario (MarcadorPosicion): encima de los lugares y de los puntos, debajo de los controles -->
        <ui:VisualElement name="capa-posicion" class="capa-posicion" picking-mode="Ignore" />
        <!-- Chincheta del punto libre (ChinchetaPunto, historia 2.5): encima de todo lo del mapa, debajo de los controles -->
        <ui:VisualElement name="capa-chincheta" class="capa-chincheta" picking-mode="Ignore" />
        <!-- Zona segura: sus márgenes los pone PantallaMapa con Screen.safeArea -->
        <ui:VisualElement name="zona-segura" class="zona-segura" picking-mode="Ignore">
            <!-- Arriba a la derecha: columna de cristal con tema y ubicación (prototipo .ctrl-stack) y, solo con
                 TalkBack, otra igual debajo con acercar y alejar -->
            <ui:VisualElement name="pila-derecha" class="pila-derecha" picking-mode="Ignore">
                <ui:VisualElement name="columna-controles" class="columna-controles" picking-mode="Ignore">
                    <ui:VisualElement name="hueco-tema" picking-mode="Ignore" />
                    <ui:VisualElement name="hueco-ubicacion" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="zoom" class="columna-controles zoom" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="atribucion" class="atribucion t-caption" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Velo transparente del menú "Precios": siempre está en el árbol, oculto; con el menú abierto cubre
             la pantalla entera (mapa, botones y marcadores), y tocarlo solo cierra el menú (PantallaMapa) -->
        <ui:VisualElement name="velo-menu" class="velo-menu" picking-mode="Ignore" />
        <!-- Filtro "Precios" arriba a la izquierda: píldora y, debajo, su menú, por encima del velo.
             Va en su propia zona segura (mismos márgenes que zona-segura, los pone PantallaMapa) -->
        <ui:VisualElement name="zona-segura-precios" class="zona-segura" picking-mode="Ignore">
            <ui:VisualElement name="hueco-precios" class="hueco-precios" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Ficha del lugar (FichaLugar, historia 1.8): velo transparente y hoja desde abajo, encima de los controles
             del mapa y debajo de las ventanas de ubicación -->
        <ui:VisualElement name="hueco-ficha" class="hueco-ficha" picking-mode="Ignore" />
        <!-- Buscador (HojaBuscador, historia 2.2): cápsula abajo que se despliega en hoja, encima de los controles del
             mapa (abierta los tapa); se oculta con la ficha abierta, así que nunca están las dos a la vez -->
        <ui:VisualElement name="hueco-buscador" class="hueco-buscador" picking-mode="Ignore" />
        <!-- Explicación del permiso de ubicación (ExplicacionUbicacion): ventana modal por encima de todo -->
        <ui:VisualElement name="hueco-explicacion" class="hueco-explicacion" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
